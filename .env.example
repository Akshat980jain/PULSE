# SUPABASE_PROJECT_ID: Your Supabase project reference ID (e.g. abcdefghijklmnopqrst)
SUPABASE_PROJECT_ID=YOUR_SUPABASE_PROJECT_ID

# SUPABASE_URL: Your Supabase project REST URL (e.g. https://abcdefghijklmnopqrst.supabase.co)
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_ID.supabase.co

# SUPABASE_PUBLISHABLE_KEY: Your Supabase publishable / anon key
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# OPENROUTER_API_KEY: Your OpenRouter API key for AI caption & critique generation
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
